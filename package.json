{
  "name": "kings-sword",
  "version": "2.8.21",
  "description": "Logiciel d'étude des sermons de W.M. Branham",
  "main": "main.js",
  "author": "Bienvenu Massamba & Gastin Ngakosso",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "node scripts/test_rag.mjs && node scripts/test_api_key_flow.mjs && node scripts/test_benchmark.mjs && node scripts/test_chunking.mjs && node scripts/test_chunk_storage.mjs && node scripts/test_embedding_validation.mjs && node scripts/test_vector_search.mjs && node scripts/test_hybrid_retrieval.mjs && node scripts/test_reranking.mjs && node scripts/test_evidence_adapter.mjs && node scripts/test_autorag_integration.mjs && node scripts/test_citation_validator.mjs && npx tsx scripts/test_embedding_index.mjs && npx tsx scripts/test_phase2f9c_anti_fallback.mjs && npx tsx scripts/test_phase2f10_generation_integration.mjs && npx tsx scripts/test_phase2f11_expose_integration.mjs && npx tsx scripts/test_unified_rag.mjs && npx tsx scripts/test_phase2f12d_integration.mjs && npx tsx scripts/test_phase2f12e_ui_validation.mjs && npx tsx scripts/test_phase2f12g_activation.mjs && npx tsx scripts/test_phase2f14_first_run.mjs && npx tsx scripts/test_phase2f15_indexing_ux.mjs && npx tsx scripts/guard_auto_test.mjs",
    "test:guard": "npx tsx scripts/guard_auto_test.mjs",
    "test:rag": "node scripts/test_rag.mjs",
    "test:api": "node scripts/test_api_key_flow.mjs",
    "test:benchmark": "node scripts/test_benchmark.mjs",
    "test:chunking": "node scripts/test_chunking.mjs",
    "test:storage": "node scripts/test_chunk_storage.mjs",
    "test:embedding": "node scripts/test_embedding_validation.mjs",
    "test:vector": "node scripts/test_vector_search.mjs",
    "test:hybrid": "node scripts/test_hybrid_retrieval.mjs",
    "test:rerank": "node scripts/test_reranking.mjs",
    "test:evidence": "node scripts/test_evidence_adapter.mjs",
    "test:integration": "node scripts/test_autorag_integration.mjs",
    "test:validator": "node scripts/test_citation_validator.mjs",
    "test:index": "npx tsx scripts/test_embedding_index.mjs",
    "test:phase2f9c": "npx tsx scripts/test_phase2f9c_anti_fallback.mjs",
    "test:phase2f10": "npx tsx scripts/test_phase2f10_generation_integration.mjs",
    "test:phase2f11": "npx tsx scripts/test_phase2f11_expose_integration.mjs",
    "test:unified": "npx tsx scripts/test_unified_rag.mjs",
    "test:phase2f12d": "npx tsx scripts/test_phase2f12d_integration.mjs",
    "test:phase2f12e": "npx tsx scripts/test_phase2f12e_ui_validation.mjs",
    "test:phase2f12g": "npx tsx scripts/test_phase2f12g_activation.mjs",
    "test:phase2f14": "npx tsx scripts/test_phase2f14_first_run.mjs",
    "test:phase2f15": "npx tsx scripts/test_phase2f15_indexing_ux.mjs",
    "eval:legacy": "node scripts/run_eval.mjs",
    "eval:comparison": "node scripts/run_benchmark_comparison.mjs",
    "eval:phase2f3": "npx tsx scripts/run_phase2f3_test.mjs",
    "eval:phase2f5b": "npx tsx scripts/run_phase2f5b_benchmark.mjs",
    "eval:pilot": "npx tsx scripts/run_phase2f7b2_pilot.mjs",
    "eval:fullindex": "npx tsx scripts/run_phase2f7c_full_index.mjs",
    "eval:phase2f8": "npx tsx scripts/run_phase2f8_shadow.mjs",
    "eval:phase2f8a": "npx tsx scripts/audit_phase2f8_legacy_baseline.mjs",
    "eval:phase2f8b": "npx tsx scripts/run_phase2f8_shadow.mjs",
    "eval:phase2f9": "npx tsx scripts/run_phase2f9_generation_ab.mjs",
    "eval:phase2f9a": "npx tsx scripts/audit_phase2f9_integrity.mjs",
    "eval:phase2f9b": "npx tsx scripts/run_phase2f9b_generation_ab.mjs",
    "eval:phase2f9c": "npx tsx scripts/run_phase2f9c_gemini_only_ab.mjs",
    "eval:phase2f11": "npx tsx scripts/run_phase2f11_expose_rag.mjs",
    "audit:phase2f12a": "npx tsx scripts/audit_phase2f12a_answerability_analysis.mjs",
    "eval:phase2f12b": "npx tsx scripts/run_phase2f12b_controlled_correction.mjs",
    "eval:phase2f12c": "npx tsx scripts/test_unified_rag.mjs",
    "eval:phase2f13": "npx tsx scripts/run_phase2f13_production_indexing.mjs",
    "audit:phase2f6": "npx tsx scripts/run_phase2f6_audit.mjs",
    "audit:phase2f7a": "npx tsx scripts/run_phase2f7a_audit.mjs",
    "audit:corpus": "npx tsx scripts/audit_corpus.mjs",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
