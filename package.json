  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.3.0",
    "docx": "^8.5.0",
    "electron-updater": "^6.1.8",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.3.0",
    "jspdf": "^2.5.1",
    "lucide-react": "^1.34.0",
    "marked": "^12.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/html2canvas": "^1.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kingssword.app",
    "productName": "King's Sword",
    "copyright": "Copyright © 2026 Bienvenu Massamba & Gastin Ngakosso",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "!**/node_modules/@xenova/transformers/.cache/**",
      "!models/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "King's Sword"
    }
  }
}
