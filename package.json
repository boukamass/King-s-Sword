"build": {
  "appId": "com.kingssword.app",
  "productName": "King's Sword",
  "copyright": "© 2026 Bienvenu Sédin Massamba",

  "directories": {
    "output": "release"
  },

  "files": [
    "dist/**/*",
    "main.js",
    "package.json",
    "node_modules/**/*"
  ],

  "win": {
    "target": "nsis",
    "icon": "public/icons/icon.ico"
  },

  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "King's Sword"
  }
}